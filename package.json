{
  "name": "tesla-hmi-mock",
  "version": "1.0.0",
  "description": "Tesla Vehicle HMI Mock - Electron + React + TypeScript + TailwindCSS",
  "main": "dist/electron/main.js",
  "scripts": {
    "start": "npm run build:electron && concurrently \"npm run start:renderer\" \"npm run start:electron\"",
    "start:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "start:electron": "wait-on http://localhost:3000 && cross-env ELECTRON_IS_DEV=1 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "tesla",
    "hmi",
    "electron",
    "react",
    "typescript",
    "tailwindcss"
  ],
  "author": "Tesla HMI Mock Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.6.0",
    "postcss": "^8.4.32",
    "postcss-loader": "^7.3.4",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.4.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0"
  },
  "build": {
    "appId": "com.tesla.hmi.mock",
    "productName": "Tesla HMI Mock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
